# Frontend configuration (optional - the defaults work for local development).
#   cp .env.example .env.local

# Where the dev server / `vite preview` proxies "/api" requests to.
# Must match the address the Django backend listens on.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Base path the browser uses to reach the API. Keep "/api" when the API is served
# from the same origin as the app (the dev proxy, or a reverse proxy in production).
# VITE_API_BASE_URL=/api

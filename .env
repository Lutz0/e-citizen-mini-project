# ---------------------------------------------------------------------------
# Public Service Request System - backend configuration
#
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
#
# .env is git-ignored. NEVER commit real secrets. Every value below is a
# placeholder or a safe local-development default.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Required when DEBUG=false. In DEBUG mode an ephemeral key is generated for
# you (sessions then reset every time the server restarts).
SECRET_KEY=

# true for local development only. MUST be false in any shared/production deployment.
DEBUG=false

ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to submit unsafe (POST/PATCH) requests. Must include the URL
# the browser uses to reach the app (the Vite dev server by default).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public URL of the frontend. Used to build links inside notification emails.
FRONTEND_URL=http://localhost:5173

TIME_ZONE=Africa/Nairobi

# --- Database --------------------------------------------------------------
# Leave unset to use SQLite at backend/db.sqlite3.
# PostgreSQL example (also run: pip install "psycopg[binary]"):
#   DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/public_services
# DATABASE_URL=

# --- Security (relevant when DEBUG=false) ----------------------------------
# Secure-only session/CSRF cookies. Defaults to true when DEBUG=false.
# SECURE_COOKIES=true
# Redirect HTTP -> HTTPS (turn on when TLS terminates at or before Django).
# SECURE_SSL_REDIRECT=false
# HSTS lifetime in seconds (0 disables). Only enable once HTTPS is working.
# SECURE_HSTS_SECONDS=0
# Session lifetime in seconds (default: 7 days).
# SESSION_COOKIE_AGE=604800

# --- Rate limiting -----------------------------------------------------------
THROTTLE_LOGIN_RATE=1000/min
THROTTLE_REGISTER_RATE=1000/hour

# --- Uploads -----------------------------------------------------------------
# Where uploaded images are stored (defaults to backend/media). Not served
# publicly: images are streamed through an authenticated API endpoint.
# MEDIA_ROOT=
# Maximum upload size in megabytes.
IMAGE_MAX_UPLOAD_MB=5

# --- Email (status-change notifications) -----------------------------------
# Default prints emails to the server console, which is ideal for development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Public Service Requests <no-reply@example.test>
# SMTP example:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.example.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=
#   EMAIL_HOST_PASSWORD=
#   EMAIL_USE_TLS=true
